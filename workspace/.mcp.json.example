{
  "mcpServers": {
    "__note_qmd": "Enable QMD semantic memory search. Requires GEMINI_API_KEY stored via `bash workspace/system/scripts/keychain-add.sh GEMINI_API_KEY`. Uncomment the qmd block below to activate.",
    "__qmd_disabled": {
      "command": "node",
      "args": [
        "PATH_TO_WORKSPACE/system/mcp-health/mcp-wrapper.js",
        "--keychain-env",
        "GEMINI_API_KEY",
        "qmd",
        "node",
        "PATH_TO_WORKSPACE/system/mcp/qmd/server.js"
      ],
      "env": {
        "QMD_WORKSPACE": "PATH_TO_WORKSPACE"
      }
    },
    "google-calendar": {
      "command": "node",
      "args": [
        "PATH_TO_GOOGLE_CALENDAR_MCP/dist/index.js"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "YOUR_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET": "YOUR_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI": "http://localhost:3000/oauth2callback"
      }
    },
    "email": {
      "command": "node",
      "args": [
        "PATH_TO_EMAIL_MCP/dist/index.js"
      ],
      "env": {
        "IMAP_HOST": "imap.gmail.com",
        "IMAP_USER": "your@gmail.com",
        "IMAP_PASS": "YOUR_APP_PASSWORD",
        "SMTP_HOST": "smtp.gmail.com",
        "SMTP_USER": "your@gmail.com",
        "SMTP_PASS": "YOUR_APP_PASSWORD"
      }
    }
  }
}
