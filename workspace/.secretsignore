# .secretsignore — paths the secrets scanner should skip.
# One pattern per line (glob). Comments OK.

# Node / Python ecosystem garbage — lots of example keys in deps
node_modules/
**/node_modules/
**/__pycache__/
.venv/
venv/

# Git internals
.git/

# Backups (scanner cannot tell real secrets from bak copies cleanly)
*.bak
*.bak-*

# Snapshots (MEMORY.md backups, not source of truth)
memory/snapshots/

# Editor swap
*.swp
.*.swp

# Local-only configs — add your allowlist here AFTER confirming the
# file only contains dev/sample secrets. Examples:
# secrets.env.example
# config/local.json.example
