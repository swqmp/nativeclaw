<script>
const token = '${token}';
async function api(path, opts={}) {
  const r = await fetch(path, {...opts, headers: {...(opts.headers||{}), 'x-nativeclaw-token': token, 'Content-Type': 'application/json'}});
  const text = await r.text();
  if (!r.ok) throw new Error(text || r.statusText);
  return text ? JSON.parse(text) : {};
}
function toast(msg, kind='ok') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show ' + kind;
  setTimeout(()=>{ el.className = 'toast ' + kind; }, 2400);
}
function escapeHtml(s) {
  return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active', x===t));
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active', p.id===t.dataset.tab));
}));

let cronJobs = [];
let mcpServers = [];

async function loadStatus() {
  try {
    const s = await api('/api/status');
    const badge = s.bridgeAlive?'status-ok':'status-err';
    document.getElementById('bridge-status').innerHTML =
      '<span class="status-badge '+badge+'">'+(s.bridgeAlive?'Alive (PID '+s.pid+')':'Dead')+'</span> '+
      (s.lastLogTime?' last log '+new Date(s.lastLogTime).toLocaleString():'');
  } catch(e){ document.getElementById('bridge-status').textContent='Error: '+e.message; }
}

async function loadConfig() {
  try {
    const c = await api('/api/config');
    document.getElementById('agentName').value = c.agentName || '';
    document.getElementById('userName').value = c.userName || '';
    document.getElementById('defaultModel').value = c.model || 'claude-sonnet-4-6';
    document.getElementById('defaultBackend').value = c.defaultBackend || 'claude';
    document.getElementById('defaultEffort').value = c.effort || 'medium';
    document.getElementById('voiceProvider').value = c.voiceProvider || 'xai';
    document.getElementById('botToken').placeholder = c.botToken === '••• set •••' ? 'Bot token set — leave blank to keep' : 'Paste bot token';
    document.getElementById('allowedChatIds').value = (c.allowedChatIds || []).join(', ');
    document.getElementById('googleCredsPath').value = c.googleCredsPath || '';
  } catch(e){ /* defaults */ }
}

async function loadMcps() {
  try {
    mcpServers = (await api('/api/mcps')).mcps;
    const enabled = mcpServers.filter(m=>m.enabled).length;
    const total = mcpServers.length;
    document.getElementById('mcp-status').innerHTML =
      '<strong>'+enabled+' enabled</strong> of '+total+' total. ' +
      '<a href="#" onclick="document.querySelector(\\'.tab[data-tab=mcps]\\').click();return false">Manage →</a>';
    const rows = mcpServers.map(m =>
      '<tr><td>'+escapeHtml(m.name)+'</td>' +
      '<td><label class="switch"><input type="checkbox" data-mcp="'+escapeHtml(m.name)+'" '+(m.enabled?'checked':'')+'/><span class="slider"></span></label></td></tr>'
    ).join('');
    document.getElementById('mcp-list').innerHTML = '<table><tr><th>Server</th><th>Enabled</th></tr>'+rows+'</table>';
    document.querySelectorAll('input[data-mcp]').forEach(inp => {
      inp.addEventListener('change', async e => {
        const name = e.target.dataset.mcp;
        const enabled = e.target.checked;
        try {
          await api('/api/mcps/toggle', { method:'POST', body: JSON.stringify({name, enabled}) });
          toast(name + (enabled?' enabled':' disabled'));
          loadMcps();
        } catch(err) { toast('Failed: '+err.message, 'err'); e.target.checked = !enabled; }
      });
    });
  } catch(e) { document.getElementById('mcp-list').textContent = 'Error: '+e.message; }
}

async function loadCron() {
  try {
    cronJobs = (await api('/api/cron')).jobs;
    document.getElementById('cron-status').innerHTML = '<strong>'+cronJobs.length+'</strong> jobs configured ('+cronJobs.filter(j=>j.enabled).length+' enabled).';
    renderCronEditor();
  } catch(e) { document.getElementById('cron-edit-list').textContent = 'Error: '+e.message; }
}

function renderCronEditor() {
  const html = cronJobs.map((j, idx) => \`
    <div class="card" style="background:#0d1117">
      <div class="field"><label>Name</label><input value="\${escapeHtml(j.name)}" data-cron-field="name" data-idx="\${idx}" /></div>
      <div class="field"><label>Schedule (cron expression)</label><input value="\${escapeHtml(j.schedule)}" data-cron-field="schedule" data-idx="\${idx}" placeholder="*/30 * * * *" /></div>
      <div class="field"><label>Enabled</label><label class="switch"><input type="checkbox" \${j.enabled?'checked':''} data-cron-field="enabled" data-idx="\${idx}" /><span class="slider"></span></label></div>
      <div class="field"><label>Prompt (preview)</label><textarea data-cron-field="prompt" data-idx="\${idx}" placeholder="Cron prompt body…">\${escapeHtml(j.prompt || j.promptPreview || '')}</textarea></div>
      <button class="btn danger small" data-cron-delete="\${idx}">Delete</button>
    </div>
  \`).join('');
  document.getElementById('cron-edit-list').innerHTML = html || '<p class="help">No jobs configured.</p>';
  document.querySelectorAll('[data-cron-field]').forEach(el => {
    el.addEventListener('input', e => {
      const idx = parseInt(e.target.dataset.idx, 10);
      const field = e.target.dataset.cronField;
      cronJobs[idx][field] = field === 'enabled' ? e.target.checked : e.target.value;
      cronJobs[idx]._dirty = true;
    });
  });
  document.querySelectorAll('[data-cron-delete]').forEach(el => {
    el.addEventListener('click', e => {
      const idx = parseInt(e.target.dataset.cronDelete, 10);
      cronJobs[idx]._delete = true;
      e.target.closest('.card').style.opacity = 0.4;
      e.target.disabled = true;
    });
  });
}

document.getElementById('add-cron').addEventListener('click', () => {
  cronJobs.push({ name: 'new-job', schedule: '*/30 * * * *', enabled: true, prompt: '' , _dirty: true });
  renderCronEditor();
});

document.getElementById('save-cron').addEventListener('click', async () => {
  const updates = cronJobs
    .filter(j => j._dirty || j._delete)
    .map(j => ({ name: j.name, schedule: j.schedule, enabled: j.enabled, prompt: j.prompt, delete: !!j._delete }));
  if (!updates.length) return toast('No changes to save', 'ok');
  try {
    await api('/api/cron', { method:'POST', body: JSON.stringify({ jobs: updates }) });
    toast('Cron schedule saved (' + updates.length + ' updates)');
    loadCron();
  } catch(e) { toast('Save failed: ' + e.message, 'err'); }
});

document.getElementById('save-config').addEventListener('click', async () => {
  const updates = {
    agentName: document.getElementById('agentName').value.trim(),
    userName: document.getElementById('userName').value.trim(),
    model: document.getElementById('defaultModel').value,
    defaultBackend: document.getElementById('defaultBackend').value,
    effort: document.getElementById('defaultEffort').value,
  };
  try {
    await api('/api/config', { method:'POST', body: JSON.stringify(updates) });
    toast('Config saved');
  } catch(e) { toast('Save failed: ' + e.message, 'err'); }
});

document.getElementById('save-connections').addEventListener('click', async () => {
  const updates = {
    voiceProvider: document.getElementById('voiceProvider').value,
    googleCredsPath: document.getElementById('googleCredsPath').value.trim(),
  };
  const botToken = document.getElementById('botToken').value.trim();
  if (botToken) updates.botToken = botToken;
  const chatIds = document.getElementById('allowedChatIds').value.split(',').map(s=>s.trim()).filter(Boolean).map(Number);
  if (chatIds.length) updates.allowedChatIds = chatIds;
  try {
    await api('/api/config', { method:'POST', body: JSON.stringify(updates) });
    toast('Connections saved');
    document.getElementById('botToken').value = '';
    loadConfig();
  } catch(e) { toast('Save failed: ' + e.message, 'err'); }
});

