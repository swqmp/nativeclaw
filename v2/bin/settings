#!/usr/bin/env node

/**
 * NativeClaw Settings UI — On-Demand Local Server
 * Starts a lightweight HTTP server at 127.0.0.1:9292 (auto-picks next if taken).
 * Auto-shutdown after 30 minutes idle.
 */

const http = require('http');
const fs = require('fs');
const path = require('path');
const { execFile } = require('child_process');
const crypto = require('crypto');

const HOME = process.env.HOME || process.env.USERPROFILE;
const SETTINGS_DIR = path.join(HOME, '.claude', 'nativeclaw-settings');
const TOKEN_FILE = path.join(SETTINGS_DIR, '.token');
const LAST_PING_FILE = path.join(SETTINGS_DIR, '.last-ping');
const IDLE_TIMEOUT_MS = 30 * 60 * 1000;
const BASE_PORT = 9292;
const HOST = '127.0.0.1';

const CONFIG_PATH = path.join(HOME, '.claude', 'telegram-bridge', 'config.json');
const MCP_PATH = path.join(HOME, '.claude', 'workspace', '.mcp.json');
const MCP_DISABLED_PATH = path.join(HOME, '.claude', 'workspace', '.mcp.disabled.json');
const CRON_PATH = path.join(HOME, '.claude', 'cron-schedule.json');
const LOG_PATH = path.join(HOME, '.claude', 'logs', 'telegram-bridge.log');
const PID_PATH = path.join(HOME, '.claude', 'telegram-bridge', 'bridge.pid');

const SECRET_FIELDS = ['botToken', 'openaiApiKey', 'anthropicApiKey', 'xaiApiKey'];

function generateToken() { return crypto.randomBytes(32).toString('hex'); }

function readToken() {
  try { return fs.readFileSync(TOKEN_FILE, 'utf8').trim(); } catch { return null; }
}

function getAuthToken() {
  let token = readToken();
  if (!token) {
    token = generateToken();
    fs.mkdirSync(SETTINGS_DIR, { recursive: true });
    fs.writeFileSync(TOKEN_FILE, token);
    fs.chmodSync(TOKEN_FILE, 0o600);
  }
  return token;
}

function updatePing() { fs.writeFileSync(LAST_PING_FILE, String(Date.now())); }
function getLastPing() {
  try { return parseInt(fs.readFileSync(LAST_PING_FILE, 'utf8'), 10) || Date.now(); } catch { return Date.now(); }
}

function readConfig() {
  try {
    const cfg = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));
    const safe = { ...cfg };
    for (const k of SECRET_FIELDS) {
      if (safe[k]) safe[k] = '••• set •••';
    }
    return safe;
  } catch { return {}; }
}

function writeConfig(updates) {
  const cur = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));
  for (const [k, v] of Object.entries(updates)) {
    // Don't overwrite secrets with the masked placeholder
    if (SECRET_FIELDS.includes(k) && v === '••• set •••') continue;
    if (v === '' || v === null || v === undefined) continue;
    cur[k] = v;
  }
  // Atomic write
  const tmp = CONFIG_PATH + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(cur, null, 2));
  fs.renameSync(tmp, CONFIG_PATH);
  return { saved: Object.keys(updates).filter(k => updates[k] !== '••• set •••') };
}

function readMcpServers() {
  let active = {}, disabled = {};
  try { active = JSON.parse(fs.readFileSync(MCP_PATH, 'utf8')).mcpServers || {}; } catch {}
  try { disabled = JSON.parse(fs.readFileSync(MCP_DISABLED_PATH, 'utf8')).mcpServers || {}; } catch {}
  const out = [];
  for (const name of Object.keys(active).sort()) out.push({ name, enabled: true });
  for (const name of Object.keys(disabled).sort()) out.push({ name, enabled: false });
  return out;
}

function toggleMcp(name, enabled) {
  let active = { mcpServers: {} }, disabled = { mcpServers: {} };
  try { active = JSON.parse(fs.readFileSync(MCP_PATH, 'utf8')); } catch {}
  try { disabled = JSON.parse(fs.readFileSync(MCP_DISABLED_PATH, 'utf8')); } catch {}
  active.mcpServers = active.mcpServers || {};
  disabled.mcpServers = disabled.mcpServers || {};

  if (enabled) {
    if (disabled.mcpServers[name]) {
      active.mcpServers[name] = disabled.mcpServers[name];
      delete disabled.mcpServers[name];
    }
  } else {
    if (active.mcpServers[name]) {
      disabled.mcpServers[name] = active.mcpServers[name];
      delete active.mcpServers[name];
    }
  }
  fs.writeFileSync(MCP_PATH + '.tmp', JSON.stringify(active, null, 2));
  fs.renameSync(MCP_PATH + '.tmp', MCP_PATH);
  fs.writeFileSync(MCP_DISABLED_PATH + '.tmp', JSON.stringify(disabled, null, 2));
  fs.renameSync(MCP_DISABLED_PATH + '.tmp', MCP_DISABLED_PATH);
  return { name, enabled };
}

function readCronJobs() {
  try {
    const cron = JSON.parse(fs.readFileSync(CRON_PATH, 'utf8'));
    return (cron.crons || cron.jobs || []).map(j => ({
      name: j.name,
      schedule: j.schedule,
      enabled: j.enabled !== false,
      timeout: j.timeout || null,
      promptPreview: (j.prompt || '').slice(0, 120),
    }));
  } catch { return []; }
}

function writeCronJobs(updates) {
  const cron = JSON.parse(fs.readFileSync(CRON_PATH, 'utf8'));
  const list = cron.crons || cron.jobs || [];
  for (const upd of updates) {
    const idx = list.findIndex(j => j.name === upd.name);
    if (idx >= 0) {
      if (upd.delete) {
        list.splice(idx, 1);
      } else {
        Object.assign(list[idx], upd);
        if ('delete' in list[idx]) delete list[idx].delete;
      }
    } else if (!upd.delete && upd.schedule && upd.prompt) {
      list.push({
        name: upd.name,
        schedule: upd.schedule,
        enabled: upd.enabled !== false,
        timeout: upd.timeout || 300,
        prompt: upd.prompt,
      });
    }
  }
  if (cron.crons) cron.crons = list; else cron.jobs = list;
  fs.writeFileSync(CRON_PATH + '.tmp', JSON.stringify(cron, null, 2));
  fs.renameSync(CRON_PATH + '.tmp', CRON_PATH);
  return { updated: updates.length };
}

function tailLog(n) {
  try {
    const data = fs.readFileSync(LOG_PATH, 'utf8');
    return data.split('\n').slice(-n).join('\n');
  } catch (err) { return `[Could not read log: ${err.message}]`; }
}

function runCli(binName, args) {
  return new Promise((resolve, reject) => {
    const binPath = path.join(__dirname, binName);
    execFile('node', [binPath, ...args], { timeout: 600_000 }, (err, stdout, stderr) => {
      if (err) reject(new Error(stderr || err.message));
      else resolve({ stdout: stdout.trim(), stderr: stderr.trim() });
    });
  });
}

async function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    req.on('data', c => chunks.push(c));
    req.on('end', () => {
      try {
        const raw = Buffer.concat(chunks).toString('utf8');
        resolve(raw ? JSON.parse(raw) : {});
      } catch (e) { reject(e); }
    });
    req.on('error', reject);
  });
}

