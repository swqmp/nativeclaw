function findPort(start, cb) {
  const server = http.createServer();
  server.listen(start, HOST, () => {
    const port = (server.address()).port;
    server.close(() => cb(port));
  });
  server.on('error', () => findPort(start + 1, cb));
}

function main() {
  const token = getAuthToken();
  findPort(BASE_PORT, (port) => {
    console.log(`⚡ NativeClaw Settings — http://${HOST}:${port}/?token=${token}`);
    console.log('Opening browser…');
    require('child_process').exec(`open "http://${HOST}:${port}/?token=${token}"`);

    const server = http.createServer(async (req, res) => {
      updatePing();
      const u = new URL(req.url || '/', `http://${req.headers.host}`);
      const pathname = u.pathname;
      const query = Object.fromEntries(u.searchParams);
      const providedToken = query.token || req.headers['x-nativeclaw-token'];

      if (providedToken !== token) {
        res.writeHead(403); res.end('Forbidden: invalid or missing token'); return;
      }

      const json = (status, body) => {
        res.writeHead(status, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify(body));
      };
      const error = (status, msg) => {
        res.writeHead(status, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: msg }));
      };

      try {
        // GET routes
        if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
          res.writeHead(200, { 'Content-Type': 'text/html' });
          return res.end(buildHTML(token, port));
        }
        if (req.method === 'GET' && pathname === '/api/status') {
          const cfg = readConfig();
          let bridgeAlive = false, pid = null;
          try {
            pid = parseInt(fs.readFileSync(PID_PATH, 'utf8'), 10);
            process.kill(pid, 0);
            bridgeAlive = true;
          } catch {}
          let lastLogTime = null;
          try { lastLogTime = fs.statSync(LOG_PATH).mtime.toISOString(); } catch {}
          return json(200, { bridgeAlive, pid, lastLogTime, agentName: cfg.agentName || null, userName: cfg.userName || null });
        }
        if (req.method === 'GET' && pathname === '/api/config') return json(200, readConfig());
        if (req.method === 'GET' && pathname === '/api/mcps')   return json(200, { mcps: readMcpServers() });
        if (req.method === 'GET' && pathname === '/api/cron')   return json(200, { jobs: readCronJobs() });
        if (req.method === 'GET' && pathname === '/api/logs')   return json(200, { log: tailLog(200) });

        // POST routes
        if (req.method === 'POST' && pathname === '/api/config') {
          const body = await readBody(req);
          return json(200, writeConfig(body));
        }
        if (req.method === 'POST' && pathname === '/api/cron') {
          const body = await readBody(req);
          if (!Array.isArray(body.jobs)) return error(400, 'Expected { jobs: [...] }');
          return json(200, writeCronJobs(body.jobs));
        }
        if (req.method === 'POST' && pathname === '/api/mcps/toggle') {
          const body = await readBody(req);
          if (!body.name) return error(400, 'Expected { name, enabled }');
          return json(200, toggleMcp(body.name, !!body.enabled));
        }
        if (req.method === 'POST' && pathname === '/api/backup') {
          const r = await runCli('backup', []);
          const match = r.stdout.match(/(?:Saved|Created|→)[: ]+([^\n]+\.zip)/);
          return json(200, { path: match ? match[1].trim() : r.stdout.split('\n').pop(), stdout: r.stdout });
        }
        if (req.method === 'POST' && pathname === '/api/diagnostic') {
          const r = await runCli('doctor', []);
          const match = r.stdout.match(/(?:Saved|Created|→)[: ]+([^\n]+\.zip)/);
          return json(200, { path: match ? match[1].trim() : r.stdout.split('\n').pop(), stdout: r.stdout });
        }

        res.writeHead(404); res.end('Not found');
      } catch (err) {
        console.error('handler error:', err);
        error(500, err.message);
      }
    });

    server.listen(port, HOST, () => {
      console.log(`Server running. Auto-shutdown in ${IDLE_TIMEOUT_MS / 60000} min idle.`);
    });

    setInterval(() => {
      const idle = Date.now() - getLastPing();
      if (idle > IDLE_TIMEOUT_MS) {
        console.log('Idle timeout reached. Shutting down.');
        server.close(() => process.exit(0));
      }
    }, 60000);
  });
}

main();
